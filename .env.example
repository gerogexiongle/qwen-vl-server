COMPOSE_PROJECT_NAME=qwen-vl

# Supported aliases:
#   qwen25-vl-3b      -> Qwen/Qwen2.5-VL-3B-Instruct, vLLM v0.7.3
#   qwen35-4b         -> Qwen/Qwen3.5-4B, latest vLLM image
#   qwen3-vl-4b       -> Qwen/Qwen3-VL-4B-Instruct, vLLM v0.11.0
#
# docker compose cannot resolve profiles dynamically; if you change MODEL_NAME
# here, also update MODEL_DIR, SERVED_MODEL_NAME, VLLM_TAG, and REQUIRED_CUDA_VERSION.
MODEL_NAME=qwen25-vl-3b
MODEL_REPO_ID=Qwen/Qwen2.5-VL-3B-Instruct
MODEL_DIR=/data/xiongle/qwen-vl-server/models/Qwen2.5-VL-3B-Instruct
SERVED_MODEL_NAME=Qwen2.5-VL-3B-Instruct

# Use qwen-vl-vllm-latest for qwen35-4b.
# Use qwen-vl-vllm-v0.11.0 for qwen3-vl-4b.
IMAGE_NAME=qwen-vl-vllm-v0.7.3
VLLM_TAG=v0.7.3

HF_CACHE_DIR=/data/xiongle/qwen-vl-server/hf_cache
GPU_DEVICE=0
HOST_PORT=18000
CONTAINER_PORT=8000

DTYPE=half
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
LIMIT_IMAGES_PER_PROMPT=5
LIMIT_VIDEOS_PER_PROMPT=5
TENSOR_PARALLEL_SIZE=1
ENFORCE_EAGER=0
TRUST_REMOTE_CODE=0
VLLM_ENABLE_CUDA_COMPATIBILITY=0
REQUIRED_CUDA_VERSION=12.1
EXTRA_VLLM_ARGS=

http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,192.168.0.0/16,172.31.0.0/16,10.0.0.0/8
